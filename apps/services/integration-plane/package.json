{
  "name": "@platform/integration-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Marketplace-facing service: connectors, OAuth callbacks, credential storage, live probes. Never reaches into a tenant data plane.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:integration": "node --test test/integration/*.test.ts",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@platform/channel-sdk": "workspace:*",
    "@platform/connector-shopee": "workspace:*",
    "@platform/connector-tiktok-tokopedia": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/observability": "workspace:*",
    "@platform/secrets": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@platform/tsconfig": "workspace:*",
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  }
}
