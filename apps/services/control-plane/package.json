{
  "name": "@platform/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tenant registry, provisioning, identity. Owns who a tenant is, not what they sell.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
