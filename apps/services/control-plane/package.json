    "start": "node src/main.ts"
  },
  "dependencies": {
    "@platform/contracts": "workspace:*",
    "@platform/http-transport": "workspace:*",
    "@platform/observability": "workspace:*",
    "@platform/secrets": "workspace:*",
    "@platform/sync-state": "workspace:*",
    "@platform/tenant-client": "workspace:*",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@platform/tsconfig": "workspace:*",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
