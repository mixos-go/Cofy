{
  "name": "@platform/workflow-queue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Engine-agnostic workflow dispatch: a WorkflowQueue port, an in-memory adapter, and a Redis/BullMQ adapter (ADR 0013).",
  "exports": {
