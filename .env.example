# Copy to .env and fill in real values locally. NEVER commit .env.
# This file lists variable NAMES only. No real secrets belong here.

# --- Core infrastructure ---
DATABASE_URL=
REDIS_URL=

# --- Control plane ---
CONTROL_PLANE_PORT=
AUTH_JWT_SECRET=
AUTH_SESSION_TTL_SECONDS=
# Used only to create the first operator account on an empty install. Unset after first boot.
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_PASSWORD=
# Working directory of the Medusa install that tenant schemas are migrated with.
MEDUSA_CWD=

# --- Tests (integration suite only; never set in production) ---
# A database the isolation suite may create and drop its own schemas in. It never touches `public`.
TEST_DATABASE_URL=

# --- Secret storage (KMS-backed). Seller credentials are stored here, never in the DB. ---
KMS_PROVIDER=
KMS_KEY_ID=
KMS_REGION=

# --- Integration plane ---
INTEGRATION_PLANE_PORT=
# Public origin the integration plane is reachable at. OAuth redirect URIs are derived from it,
# so it must match what is registered with each marketplace app. Never guessed from a header.
INTEGRATION_PLANE_PUBLIC_BASE_URL=
# Comma-separated bearer tokens the control plane and worker present. The service refuses to
# start without at least one.
INTEGRATION_SERVICE_TOKENS=
WEBHOOK_BASE_URL=

# --- Marketplace apps (platform-owned, see docs/adr/0003) ---
# TikTok Shop
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Tokopedia Open Platform (separate app, bound to the TikTok Shop app)
TOKOPEDIA_APP_KEY=
TOKOPEDIA_APP_SECRET=
# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# --- Worker / workflow engine ---
WORKER_PORT=
WORKFLOW_ENGINE_REDIS_URL=
RECONCILIATION_INTERVAL_SECONDS=

# --- Observability ---
LOG_LEVEL=
