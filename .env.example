# Copy to .env and fill in real values locally. NEVER commit .env.
# This file lists variable NAMES only. No real secrets belong here.

# --- Core infrastructure ---
# For a managed Postgres that requires TLS, put the mode in the URL; it is the single source of
# truth for both Medusa and the control plane's own pools:
#   local:   postgres://user:pw@127.0.0.1:5432/platform
#   managed: postgres://user:pw@host:5432/platform?sslmode=require
#            ...&sslrootcert=/path/to/provider-ca.pem   (a CA Node does not already trust)
#   managed: postgres://user:pw@host:5432/platform?sslmode=no-verify  (encrypt, do not verify)
# `sslmode=require` verifies the chain and needs the provider CA installed or given via
# `sslrootcert`; `no-verify` encrypts without verifying and is the escape hatch when it is not.
# Do not rely on a bare URL against a TLS-required server: Medusa's driver defaults to
# unencrypted and the migration is refused. See docs/adr/0011.
DATABASE_URL=
REDIS_URL=

# --- Control plane ---
CONTROL_PLANE_PORT=
AUTH_JWT_SECRET=
AUTH_SESSION_TTL_SECONDS=
# Used only to create the first operator account on an empty install. Unset after first boot.
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_PASSWORD=
# Working directory of the Medusa install that tenant schemas are migrated with.
MEDUSA_CWD=

# --- Tests (integration suite only; never set in production) ---
# A database the isolation suite may create and drop its own schemas in. It never touches `public`.
TEST_DATABASE_URL=

# --- Secret storage (KMS-backed). Seller credentials are stored here, never in the DB. ---
KMS_PROVIDER=
KMS_KEY_ID=
KMS_REGION=

# --- Integration plane ---
INTEGRATION_PLANE_PORT=
# Public origin the integration plane is reachable at. OAuth redirect URIs are derived from it,
# so it must match what is registered with each marketplace app. Never guessed from a header.
INTEGRATION_PLANE_PUBLIC_BASE_URL=
# Comma-separated bearer tokens the control plane and worker present. The service refuses to
# start without at least one.
INTEGRATION_SERVICE_TOKENS=
WEBHOOK_BASE_URL=
# Per-channel app-key rate budgets as JSON, e.g. {"shopee":{"capacity":50,"refillPerSecond":10}}.
# A malformed value stops startup rather than silently using the conservative default: the wrong
# budget for a channel is exactly the overspending the governor exists to prevent.
RATE_LIMIT_APP_BUDGETS=

# --- Marketplace apps (platform-owned, see docs/adr/0003) ---
# TikTok Shop
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Tokopedia Open Platform (separate app, bound to the TikTok Shop app)
TOKOPEDIA_APP_KEY=
TOKOPEDIA_APP_SECRET=
# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# --- Worker / workflow engine ---
WORKER_PORT=
WORKFLOW_ENGINE_REDIS_URL=
RECONCILIATION_INTERVAL_SECONDS=
# Bearer tokens the worker presents to the control plane's sync-state surface. Must match the
# worker's value. Empty closes the surface rather than opening it.
CONTROL_PLANE_SERVICE_TOKENS=
# The worker calls the control plane (sync state) and the integration plane (marketplaces) over
# HTTP; services never import each other (AGENTS.md §3).
CONTROL_PLANE_BASE_URL=
INTEGRATION_PLANE_BASE_URL=
# Per-tenant Medusa targets are resolved through the control plane; the worker holds no single base
# URL or admin token. Commerce writes go through the tenant's own API, never its database (ADR 0010,
# ADR 0012). Set the CA bundle only when tenant engines use a private issuer; absent means the
# system trust store.
MEDUSA_TENANT_CA_CERT_PATH=

# --- Control plane: tenant Medusa provisioning (ADR 0012) ---
# URL template with a literal {tenantId} placeholder, e.g. https://{tenantId}.medusa.internal
MEDUSA_TENANT_URL_TEMPLATE=
# Credential that may create API keys inside a single tenant instance. Distinct from the per-tenant
# secret key the worker uses; provisioned once, never the worker's token.
MEDUSA_PROVISIONER_TOKEN=

# --- Observability ---
LOG_LEVEL=
