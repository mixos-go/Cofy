{
  "name": "omnichannel-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "boundaries": "pnpm --filter @platform/boundaries check",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries && pnpm vendor:check",
    "check:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries && pnpm vendor:check && pnpm test:integration",
    "vendor:check": "node tooling/vendor/check-vendor-integrity.mjs connectors/shopee/vendor/shopee-sdk && node tooling/vendor/check-vendor-integrity.mjs connectors/tiktok-tokopedia/vendor/tiktok-shop-sdk"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0"
  }
}
