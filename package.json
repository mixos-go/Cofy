{
  "name": "omnichannel-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "boundaries": "pnpm --filter @platform/boundaries check",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
