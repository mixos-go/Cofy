  },
  "devDependencies": {
    "@medusajs/medusa": "2.21.1",
    "@medusajs/order": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  }
}
